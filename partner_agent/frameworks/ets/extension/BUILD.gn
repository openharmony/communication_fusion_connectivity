import("//build/ohos.gni")
import("//foundation/communication/fusion_connectivity/fusion_connectivity.gni")

SUBSYSTEM_DIR = "//foundation/communication/fusion_connectivity"
PARTNER_AGENT_ROOT = "$SUBSYSTEM_DIR/partner_agent"

config("ets_ability_config") {
  visibility = [ ":*" ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  defines = [ "LOG_DOMAIN = 0xD000100" ]
}

ohos_shared_library("partner_agent_extension_ani") {
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"
  cflags_cc = [
    "-Wno-unused-parameter",
    "-ffunction-sections",
    "-fdata-sections",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Oz",
    "-fno-rtti",
    "-fno-exceptions",
    "-flto",
  ]
  include_dirs = [
    "$PARTNER_AGENT_ROOT/frameworks/ets/include",
    "$PARTNER_AGENT_ROOT/frameworks/ets/extension/include",
    "$PARTNER_AGENT_ROOT/frameworks/inner/include/extension",
    "$PARTNER_AGENT_ROOT/frameworks/inner/include",
  ]
  sources = [
    "src/ets_partner_agent_extension_context.cpp",
    "src/ets_partner_agent_extension.cpp",
  ]
  configs = [ ":ets_ability_config" ]

  deps = [
    "$SUBSYSTEM_DIR/partner_agent/frameworks/inner:partner_agent_extension_common",
    "$SUBSYSTEM_DIR/partner_agent/idl:partner_agent_extension_ipc",
    "$SUBSYSTEM_DIR/partner_agent/idl:libpartner_device_agent_proxy",
    "$SUBSYSTEM_DIR/partner_agent/idl:libpartner_device_agent_stub",
    "$PARTNER_AGENT_ROOT/frameworks/inner:partner_device_agent_framework",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:ability_context_native",
    "ability_runtime:ability_manager",
    "ability_runtime:app_context",
    "ability_runtime:extensionkit_native",
    "ability_runtime:ani_common",
    "ability_runtime:napi_common",
    "ability_runtime:runtime",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "hiappevent:hiappevent_innerapi",
    "ipc:ipc_core",
    "ipc:ipc_napi",
    "napi:ace_napi",
    "runtime_core:ani",
    "runtime_core:ani_helpers",
  ]

  subsystem_name = "communication"
  part_name = "fusion_connectivity"
}

import("//build/ohos.gni")

FUSION_RANGING = "//foundation/communication/fusion_connectivity/fusion_ranging"

fusion_ranging_manager_framework_sources = [
  "src/fusion_ranging_manager.cpp",
  "src/fusion_ranging_observer.cpp",
]

fusion_ranging_manager_framework_deps = [
  "$FUSION_RANGING/idl:libfusion_ranging_proxy",
  "$FUSION_RANGING/idl:libfusion_ranging_stub",
  "$FUSION_RANGING/services/common:fusion_ranging_common",
]

fusion_ranging_manager_framework_external_deps = [
  "hilog:libhilog",
  "ipc:ipc_core",
  "ipc:ipc_napi",
  "c_utils:utils",
  "samgr:samgr_proxy",
  "init:libbegetutil",
]

config("fusion_ranging_manager_framework_config") {
  include_dirs = [
    "${target_gen_dir}",
    "$FUSION_RANGING/idl/include",
    "$FUSION_RANGING/interfaces/inner_api",
    "$FUSION_RANGING/frameworks/inner/include",
    "$FUSION_RANGING/../frameworks/inner/include",
    "$FUSION_RANGING/services/common/include",
  ]

  cflags_cc = [
    "-ffunction-sections",
    "-fdata-sections",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Oz",
    "-fno-rtti",
    "-fno-exceptions",
    "-flto",
  ]
}

ohos_shared_library("fusion_ranging_manager_framework") {
  version_script = "libfusion_ranging_manager_framework_version_script.txt"
  sanitize = {
    cfi = true
    boundary_sanitize = true
    integer_overflow = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
    ubsan = true
  }
  branch_protector_ret = "pac_ret"

  install_enable = true

  sources = fusion_ranging_manager_framework_sources

  defines = [
    "LOG_DOMAIN = 0xD000100",
  ]

  deps = fusion_ranging_manager_framework_deps

  external_deps = fusion_ranging_manager_framework_external_deps

  configs = [
    ":fusion_ranging_manager_framework_config"
  ]

  ldflags = [
    "-flto",
    "-Wl,--as-needed",
    "-Wl,--gc-sections",
  ]

  if (defined(global_parts_info) &&
      defined(global_parts_info.communication_nearlink_service)) {
    defines += [
      "SUPPORT_FUSION_RANGING",
    ]
  }

  part_name = "fusion_connectivity"
  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "communication"
}
import IFusionRangingType;
import IRangingResultObserver;
import IRangingStateObserver;

package OHOS.FusionRanging;
option_stub_hooks on;

sequenceable OHOS.FusionRanging.RangingResult;
sequenceable OHOS.FusionRanging.RangingParams;
sequenceable OHOS.FusionRanging.RangingCapabilitySupported;

interface OHOS.FusionRanging.IFusionRanging {
    void GetRangingCapability([out] RangingCapabilitySupported capability);
    void StartRanging([in] RangingParams params, [in] IRangingResultObserver observer);
    void StopRanging([in] String deviceId, [in] IRangingResultObserver observer);
    void RegisterStateObserver([in] IRangingStateObserver observer);
    void UnregisterStateObserver([in] IRangingStateObserver observer);
}
import("//build/ohos.gni")
import("//foundation/communication/fusion_connectivity/fusion_connectivity.gni")

FUSION_RANGING = "//foundation/communication/fusion_connectivity/fusion_ranging"

ohos_shared_library("fusion_ranging_service") {
  # CFI
  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  sanitize = {
    cfi = true                            # Enable/disable control flow integrity detection
    boundary_sanitize = true               # Enable boundary san detection
    cfi_cross_dso = true                   # Cross-SO CFI Checks
    integer_overflow = true                # Enable integer overflow detection
    ubsan = true                           # Enable some Ubsan options
    debug = false
  }

  sources = [
    "src/fusion_ranging_service.cpp",
    "$FUSION_RANGING/../partner_agent/services/common/src/fcm_thread_util.cpp",
  ]

  include_dirs = [
    "include",
    "${target_gen_dir}",
    "$FUSION_RANGING/interfaces/inner_api",
    "$FUSION_RANGING/frameworks/inner/include",
    "$FUSION_RANGING/idl/include",
    "$FUSION_RANGING/../partner_agent/frameworks/inner/include",
    "$FUSION_RANGING/../partner_agent/services/common/include",
  ]

  deps = [
    "$FUSION_RANGING/idl:libfusion_ranging_stub",
    "$FUSION_RANGING/services/ranging_adapter:fusion_ranging_adapter",
    "$FUSION_RANGING/services/common:fusion_ranging_common",
  ]

  external_deps = [
    "hilog:libhilog",
    "c_utils:utils",
    "ffrt:libffrt",
    "ipc:ipc_core",
  ]

  defines = [
    "LOG_DOMAIN = 0xD000100",
  ]

  cflags = [
    "-Wno-unused-parameter",
  ]

  if (defined(global_parts_info) &&
      defined(global_parts_info.communication_nearlink_service)) {
    if (target_cpu == "arm64" || is_emulator) {
      nearlink_ranging_adapter_path = "\"/system/lib64\""
    } else {
      nearlink_ranging_adapter_path = "\"/system/lib\""
    }

    defines += [
      "SUPPORT_NEARLINK_RANGING",
      "NEARLINK_RANGING_ADAPTER_PATH=${nearlink_ranging_adapter_path}",
    ]
  }

  part_name = "fusion_connectivity"
  subsystem_name = "communication"
}
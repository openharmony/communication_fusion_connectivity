import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
import("//build/ohos/taihe_idl/taihe.gni")

SUBSYSTEM_DIR = "//foundation/communication/fusion_connectivity"
FUSION_RANGING_ROOT = "$SUBSYSTEM_DIR/fusion_ranging"
PARTNER_AGENT_ROOT = "$SUBSYSTEM_DIR/partner_agent"

copy_taihe_idl("partner_agent_taihe") {
  sources = [ "idl/ohos.FusionConnectivity.partnerAgent.taihe" ]
  external_deps = [ "bluetooth:bluetooth_common_taihe" ]
}

taihe_generated_file_path =
    "$taihe_file_path/out/communication/fusion_connectivity/partner_agent"

ohos_taihe("run_taihe") {
  taihe_generated_file_path = "${taihe_generated_file_path}"
  deps = [ ":partner_agent_taihe" ]
  outputs = [
    "$taihe_generated_file_path/src/ohos.FusionConnectivity.partnerAgent.ani.cpp",
    "$taihe_generated_file_path/src/ohos.FusionConnectivity.partnerAgent.abi.c",
  ]
}

taihe_shared_library("FusionConnectivityPartnerAgent_taihe_native") {
  taihe_generated_file_path = "${taihe_generated_file_path}"
  part_name = "fusion_connectivity"
  subsystem_name = "communication"
  sources = get_target_outputs(":run_taihe")
  shlib_type = "ani"
  include_dirs = [
    "idl",
    "include",
    "common",
    "src",
    "$FUSION_RANGING_ROOT/frameworks/ets/taihe/common",
    "$FUSION_RANGING_ROOT/frameworks/inner/include",
    "$FUSION_RANGING_ROOT/interfaces/inner_api",
    "$FUSION_RANGING_ROOT/idl/include",
    "$FUSION_RANGING_ROOT/services/common/include",
    "$PARTNER_AGENT_ROOT/interfaces/inner_api",
    "$PARTNER_AGENT_ROOT/idl/include",
    "$PARTNER_AGENT_ROOT/services/common/include",
  ]
  sources += [
    "$FUSION_RANGING_ROOT/frameworks/ets/taihe/common/taihe_fusion_connectivity_error.cpp",
    "$FUSION_RANGING_ROOT/frameworks/ets/taihe/common/taihe_fusion_connectivity_utils.cpp",
    "common/taihe_fusion_connectivity_utils.cpp",
    "src/ani_constructor.cpp",
    "src/ohos.FusionConnectivity.partnerAgent.impl.cpp",
  ]
  deps = [
    ":run_taihe",
    "$PARTNER_AGENT_ROOT/frameworks/inner:partner_device_agent_framework",
    "$PARTNER_AGENT_ROOT/idl:libpartner_device_agent_proxy",
    "$PARTNER_AGENT_ROOT/idl:libpartner_device_agent_stub",
  ]
  external_deps = [
    "bluetooth:bluetooth_common_taihe",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "hiappevent:hiappevent_innerapi",
    "hilog:libhilog",
    "ipc:ipc_single",
    "runtime_core:ani_helpers",
    "samgr:samgr_proxy",
  ]
  configs = [ ":partner_agent_taihe_config" ]
  ldflags = [
    "-flto",
    "-Wl,--as-needed",
    "-Wl,--gc-sections",
  ]
  sanitize = {
    cfi = true
    boundary_sanitize = true
    cfi_cross_dso = true
    integer_overflow = true
    ubsan = true
    debug = false
  }
}

config("partner_agent_taihe_config") {
  cflags_cc = [
    "-Oz",
    "-fno-rtti",
    "-fno-exceptions",
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-fno-merge-all-constants",
    "-flto",
  ]
}

generate_static_abc("fusionConnectivityPartnerAgent_abc") {
  base_url = "${taihe_generated_file_path}"
  files = [
    "${taihe_generated_file_path}/@ohos.FusionConnectivity.partnerAgent.ets",
  ]
  is_boot_abc = "True"
  device_dst_file = "/system/framework/fusionConnectivityPartnerAgent_abc.abc"
  dependencies = [ ":run_taihe" ]
}

ohos_prebuilt_etc("fusionConnectivityPartnerAgent_etc") {
  source = "$target_out_dir/fusionConnectivityPartnerAgent_abc.abc"
  module_install_dir = "framework"
  part_name = "fusion_connectivity"
  subsystem_name = "communication"
  deps = [ ":fusionConnectivityPartnerAgent_abc" ]
}

group("partnerAgent_taihe") {
  deps = [
    ":FusionConnectivityPartnerAgent_taihe_native",
    ":fusionConnectivityPartnerAgent_etc",
  ]
}

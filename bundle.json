{
    "name": "@ohos/fusion_connectivity",
    "description": "Provide fusional service for connectivity",
    "version": "6.0",
    "license": "Apache License 2.0",
    "repository": "",
    "homePage": "",
    "domain": "os",
    "language": "",
    "private": false,
    "tags": ["foundation"],
    "keywords":[
        "communication",
        "fusion_connectivity"
    ],
    "publishAs": "code-segment",
    "segment": {
        "destPath": "foundation/communication/fusion_connectivity"
    },
    "envs": [],
    "dirs": [],
    "scripts": {},
    "author": {},
    "contributors": {},
    "component": {
        "name": "fusion_connectivity",
        "subsystem": "communication",
        "syscap": [
            "SystemCapability.Communication.FusionConnectivity.Core"
        ],
        "features": [
            "fusion_connectivity_partner_agent_feature",
            "fusion_connectivity_settings_bundle_name",
            "fusion_connectivity_settings_main_ability"
        ],
        "adapted_system_type": [
            "standard"
        ],
        "rom": "",
        "ram": "",
        "hisysevent_config": [
        ],
        "deps": {
            "components": [
                "hilog",
                "ipc",
                "samgr",
                "c_utils",
                "ffrt",
                "bluetooth",
                "safwk",
                "libuv",
                "ets_frontend",
                "napi",
                "access_token",
                "ability_base",
                "ability_runtime",
                "bundle_framework",
                "eventhandler",
                "init",
                "common_event_service",
                "cJSON",
                "preferences",
                "os_account",
                "distributed_notification_service",
                "hiappevent",
                "selinux_adapter",
                "runtime_core",
                "taihe_ffi_gen"
              ],
              "third_party": [
              ]
        },
        "build": {
            "group_type": {
                "base_group": [],
                "fwk_group": [
                    "//foundation/communication/fusion_connectivity/partner_agent/frameworks/inner:partner_device_agent_framework",
                    "//foundation/communication/fusion_connectivity/partner_agent/frameworks/napi:napi_partner_agent_extension",
                    "//foundation/communication/fusion_connectivity/partner_agent/frameworks/napi:partneragent",
                    "//foundation/communication/fusion_connectivity/partner_agent/frameworks/napi/src/extension:napi_packages",
                    "//foundation/communication/fusion_connectivity/fusion_ranging/frameworks/inner:fusion_ranging_manager_framework",
                    "//foundation/communication/fusion_connectivity/fusion_ranging/frameworks/napi:ranging",
                    "//foundation/communication/fusion_connectivity/fusion_ranging/frameworks/ets/taihe:fusionRanging_taihe"
                ],
                "service_group": [
                    "//foundation/communication/fusion_connectivity/partner_agent/sa_profile:partner_device_agent_sa_profile",
                    "//foundation/communication/fusion_connectivity/partner_agent/services/server:partner_device_agent_server",
                    "//foundation/communication/fusion_connectivity/partner_agent/services/server:libpartner_agent_extension_service",
                    "//foundation/communication/fusion_connectivity/partner_agent/idl:partner_device_agent",
                    "//foundation/communication/fusion_connectivity/fusion_ranging/sa_profile:fusion_ranging_sa_profile",
                    "//foundation/communication/fusion_connectivity/fusion_ranging/services/ranging_adapter:fusion_ranging_adapter",
                    "//foundation/communication/fusion_connectivity/fusion_ranging/services/server:fusion_ranging_server",
                    "//foundation/communication/fusion_connectivity/fusion_ranging/idl:fusion_ranging"
                ]
            },
            "inner_api": [
                {
                    "header": {
                        "header_base": "//foundation/communication/fusion_connectivity/partner_agent/interfaces/inner_api",
                        "header_files": [
                            "partner_device_agent.h"
                        ]
                    },
                    "name": "//foundation/communication/fusion_connectivity/partner_agent/frameworks/inner:partner_device_agent_framework"
                }
            ],
            "inner_kits": [
                {
                    "header": {
                        "header_base": "//foundation/communication/fusion_connectivity/fusion_ranging/services/ranging_adapter/include",
                        "header_files": [
                            "base_ranging_adapter.h"
                         ]
                    },
                    "name": "//foundation/communication/fusion_connectivity/fusion_ranging/services/ranging_adapter:fusion_ranging_adapter"
                }
            ],
            "test": [
                "//foundation/communication/fusion_connectivity/partner_agent/test:fusion_connectivity_test",
                "//foundation/communication/fusion_connectivity/fusion_ranging/test:fusion_ranging_test"
            ]
        }
    }
}
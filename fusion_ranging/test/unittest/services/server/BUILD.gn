import("//build/test.gni")
import("//build/ohos_var.gni")

module_output_path = "fusion_connectivity/fusion_ranging"
FUSION_RANGING = "//foundation/communication/fusion_connectivity/fusion_ranging"

fusion_ranging_test_deps = [
  "$FUSION_RANGING/services/ranging_adapter:fusion_ranging_adapter",
  "$FUSION_RANGING/services/common:fusion_ranging_common",
  "$FUSION_RANGING/idl:libfusion_ranging_stub",
  "$FUSION_RANGING/idl:libfusion_ranging_proxy",
]

fusion_ranging_test_external_deps = [
  "c_utils:utils",
  "hilog:libhilog",
  "ipc:ipc_single",
  "ipc:ipc_core",
  "googletest:gmock_main",
  "googletest:gtest_main",
  "safwk:system_ability_fwk",
  "samgr:samgr_proxy",
  "ability_runtime:ability_manager",
  "ability_runtime:app_manager",
  "access_token:libaccesstoken_sdk",
  "access_token:libtokenid_sdk",
  "access_token:libprivacy_sdk",
  "bundle_framework:appexecfwk_base",
  "ffrt:libffrt",
]

config("unittest_config") {
  include_dirs = [
    "${target_gen_dir}",
    "$FUSION_RANGING/services/server/include",
    "$FUSION_RANGING/services/service/include",
    "$FUSION_RANGING/services/ranging_adapter/include",
    "$FUSION_RANGING/services/common/include",
    "$FUSION_RANGING/interfaces/inner_api",
    "$FUSION_RANGING/idl/include",
    "$FUSION_RANGING/../partner_agent/services/common/include",
    "$FUSION_RANGING/../partner_agent/interfaces/inner_api",
  ]

  defines = [
    "LOG_DOMAIN = 0xD000100",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("fusion_ranging_server_test") {
  module_out_path = module_output_path

  sources = [
    "fusion_ranging_server_test.cpp",
    "$FUSION_RANGING/services/server/src/fusion_ranging_server.cpp",
    "$FUSION_RANGING/services/server/src/fusion_ranging_service.cpp",
    "$FUSION_RANGING/services/server/src/process_death_manager.cpp",
    "$FUSION_RANGING/services/common/src/log_utils.cpp",
    "$FUSION_RANGING/../partner_agent/services/common/src/fcm_thread_util.cpp",
    "$FUSION_RANGING/../partner_agent/services/common/src/permission_manager.cpp",
  ]

  configs = [ ":unittest_config" ]

  deps = fusion_ranging_test_deps

  external_deps = fusion_ranging_test_external_deps
}

ohos_unittest("process_death_manager_test") {
  module_out_path = module_output_path

  sources = [
    "process_death_manager_test.cpp",
    "$FUSION_RANGING/services/server/src/process_death_manager.cpp",
    "$FUSION_RANGING/services/server/src/fusion_ranging_server.cpp",
    "$FUSION_RANGING/services/server/src/fusion_ranging_service.cpp",
    "$FUSION_RANGING/services/common/src/log_utils.cpp",
    "$FUSION_RANGING/../partner_agent/services/common/src/permission_manager.cpp",
    "$FUSION_RANGING/../partner_agent/services/common/src/fcm_thread_util.cpp",
  ]

  configs = [ ":unittest_config" ]

  deps = fusion_ranging_test_deps

  external_deps = fusion_ranging_test_external_deps
}

ohos_unittest("fusion_ranging_service_test") {
  module_out_path = module_output_path

  sources = [
    "fusion_ranging_service_test.cpp",
    "$FUSION_RANGING/services/server/src/fusion_ranging_service.cpp",
    "$FUSION_RANGING/../partner_agent/services/common/src/fcm_thread_util.cpp",
  ]

  configs = [ ":unittest_config" ]

  deps = fusion_ranging_test_deps

  external_deps = fusion_ranging_test_external_deps
}

group("unit_test") {
  testonly = true

  deps = [
    ":fusion_ranging_server_test",
    ":process_death_manager_test",
    ":fusion_ranging_service_test",
  ]
}
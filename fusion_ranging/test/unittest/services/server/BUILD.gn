import("//build/test.gni")
import("//build/ohos_var.gni")

module_output_path = "fusion_ranging/fusion_ranging"
FUSION_RANGING = "//foundation/communication/fusion_connectivity/fusion_ranging"

config("unittest_config") {
  include_dirs = [
    "${target_gen_dir}",
    "$FUSION_RANGING/services/server/include",
    "$FUSION_RANGING/services/service/include",
    "$FUSION_RANGING/services/common/include",
    "$FUSION_RANGING/interfaces/inner_api",
    "$FUSION_RANGING/idl/include",
    "$FUSION_RANGING/../partner_agent/services/common/include",
  ]

  defines = [
    "LOG_DOMAIN = 0xD000100",
    "private = public",
    "protected = public",
  ]
}

ohos_unittest("fusion_ranging_server_test") {
  module_out_path = module_output_path

  sources = [
    "fusion_ranging_server_test.cpp",
  ]

  configs = [ ":unittest_config" ]

  deps = [
    "$FUSION_RANGING/services/server:fusion_ranging_server",
    "$FUSION_RANGING/services/service:fusion_ranging_service",
    "$FUSION_RANGING/idl:libfusion_ranging_stub",
    "$FUSION_RANGING/idl:libfusion_ranging_proxy",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "ipc:ipc_core",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]
}


import("//build/ohos.gni")
import("//build/ohos_var.gni")
import("//foundation/communication/fusion_connectivity/fusion_connectivity.gni")

FUSION_CONN = "//foundation/communication/fusion_connectivity/"

config("fusion_connectivity_fwk_inner_cfg") {
  include_dirs = [
    "$FUSION_CONN/partner_agent/frameworks/inner/include",
    "$FUSION_CONN/partner_agent/services/common/include",
    "$FUSION_CONN/partner_agent/idl/include",
  ]

  if (fusion_connectivity_partner_agent_feature) {
    defines = [
      "ENABLE_PARTNER_AGENT_FEATURE"
    ]
  }
}

config("fusion_connectivity_fwk_public_cfg") {
  include_dirs = [
    "$FUSION_CONN/partner_agent/interfaces/inner_api",
    "$FUSION_CONN/partner_agent/idl/include",
  ]
}

ohos_shared_library("partner_device_agent_framework") {
  sanitize = {
    cfi = true
    boundary_sanitize = true
    integer_overflow = true
    cfi_cross_dso = true
    debug = false
    ubsan = true
  }
  branch_protector_ret = "pac_ret"

  install_enable = true

  sources = [
    "src/partner_device_agent.cpp",
  ]

  deps = [
    "$FUSION_CONN/partner_agent/idl:libpartner_device_agent_proxy",
    "$FUSION_CONN/partner_agent/idl:libpartner_device_agent_stub",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "ipc:ipc_napi",
    "samgr:samgr_proxy",
    "init:libbegetutil",
  ]

  defines = [
    "LOG_DOMAIN = 0xD000100",
  ]

  configs = [ ":fusion_connectivity_fwk_inner_cfg" ]
  public_configs = [ ":fusion_connectivity_fwk_public_cfg" ]

  part_name = "fusion_connectivity" 
  innerapi_tags = [ "platformsdk" ] 
  subsystem_name = "communication" 
} 

ohos_source_set("partner_agent_extension_common") { 
  sanitize = { 
    integer_overflow = true 
    ubsan = true 
    boundary_sanitize = true 
    cfi = true 
    cfi_cross_dso = true 
    debug = false 
  } 
  branch_protector_ret = "pac_ret" 


  include_dirs = [  
    "$FUSION_CONN/partner_agent/frameworks/inner/include/extension", 
    "$FUSION_CONN/partner_agent/frameworks/inner/include", 
    "$FUSION_CONN/partner_agent/frameworks/napi/include/extension", 
    "$FUSION_CONN/partner_agent/idl/include", 
  ] 


  sources = [ 
    "$FUSION_CONN/partner_agent/frameworks/inner/src/extension/partner_agent_extension.cpp", 
    "$FUSION_CONN/partner_agent/frameworks/inner/src/extension/partner_agent_extension_context.cpp", 
    "$FUSION_CONN/partner_agent/frameworks/inner/src/extension/partnre_agent_extension_stub_impl.cpp", 
  ] 

  configs = [] 
  public_configs = [] 


  deps = [ 
    "$FUSION_CONN/partner_agent/idl:partner_agent_extension_ipc", 
    "$FUSION_CONN/partner_agent/idl:libpartner_device_agent_proxy", 
    "$FUSION_CONN/partner_agent/idl:libpartner_device_agent_stub",   
  ] 


  defines = [ 
    "LOG_DOMAIN = 0xD000100", 
  ] 

  external_deps = [ 
    "ability_base:want", 
    "ability_base:zuri", 
    "ability_runtime:ability_context_native", 
    "ability_runtime:ability_manager", 
    "ability_runtime:app_context", 
    "ability_runtime:extensionkit_native", 
    "ability_runtime:napi_common", 
    "ability_runtime:runtime", 
    "access_token:libaccesstoken_sdk", 
    "access_token:libtokenid_sdk", 
    "c_utils:utils", 
    "eventhandler:libeventhandler", 
    "hilog:libhilog", 
    "ipc:ipc_napi", 
    "napi:ace_napi", 
  ] 

  subsystem_name = "communication" 
  part_name = "fusion_connectivity" 
}
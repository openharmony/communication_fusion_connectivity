import("//build/ohos.gni")

FUSION_RANGING = "//foundation/communication/fusion_connectivity/fusion_ranging"

config("fusion_ranging_common_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "include",
    "$FUSION_RANGING/../partner_agent/frameworks/inner/include",
    "$FUSION_RANGING/interfaces/inner_api",
  ]
  defines = [
    "LOG_DOMAIN = 0xD000100",
  ]
  cflags_cc = [
    "-ffunction-sections",
    "-fdata-sections",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Oz",
    "-fno-rtti",
    "-fno-exceptions",
  ]
}

ohos_static_library("fusion_ranging_common") {
  sources = [
    "src/log_utils.cpp",
    "src/common_utils.cpp",
  ]

  include_dirs = [
    "include",
    "$FUSION_RANGING/interfaces/inner_api",
  ]

  public_configs = [ ":fusion_ranging_common_config" ]

  external_deps = [
    "hilog:libhilog",
  ]

  part_name = "fusion_connectivity"
  subsystem_name = "communication"
}
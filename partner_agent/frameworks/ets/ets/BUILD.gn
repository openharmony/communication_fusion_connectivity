import("//foundation/communication/fusion_connectivity/fusion_connectivity.gni")
import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")

generate_static_abc("partnerAgent_extension_ability_ani") {
  base_url = "./"
  files = [
    "./@ohos.FusionConnectivity.PartnerAgentExtensionAbility.ets",
    "./@ohos.FusionConnectivity.PartnerAgentExtensionContext.ets",
  ]

  is_boot_abc = "True"
  device_dst_file = "/system/framework/partnerAgent_extension_ability_ani.abc"
}

ohos_prebuilt_etc("partnerAgent_extension_ability_prebuilt") {
  source = "$target_out_dir/partnerAgent_extension_ability_ani.abc"
  deps = [ ":partnerAgent_extension_ability_ani" ]
  module_install_dir = "framework"
  subsystem_name = "communication"
  part_name = "fusion_connectivity"
}

group("partnerAgent_extension_ability_etc") {
  deps = [ ":partnerAgent_extension_ability_prebuilt" ]
}

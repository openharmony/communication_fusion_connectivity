@!namespace("@ohos.FusionConnectivity.partnerAgent", "partnerAgent")
@!sts_inject("""
  static { loadLibraryWithPermissionCheck("FusionConnectivityPartnerAgent_taihe_native.z", "@ohos.FusionConnectivity.partnerAgent") }
""")

use ohos.bluetooth.common as common;

function IsPartnerAgentSupported(): bool;

@promise function BindDevice(deviceAddress: PartnerDeviceAddress, deviceCapability: DeviceCapability,
    businessCapability: BusinessCapability, partnerAgentExtensionAbilityName: String): void;

@promise function UnbindDevice(deviceAddress: PartnerDeviceAddress): void;

function IsDeviceBound(deviceAddress: PartnerDeviceAddress): bool;

function GetBoundDevices(): Array<PartnerDeviceAddress>;

@promise function EnableDeviceControl(deviceAddress: PartnerDeviceAddress): void;

@promise function DisableDeviceControl(deviceAddress: PartnerDeviceAddress): void;

function IsDeviceControlEnabled(deviceAddress: PartnerDeviceAddress): bool;

struct DeviceCapability {
    supportBR: Optional<bool>;
    supportBleAdvertiser: Optional<bool>;
}

struct BusinessCapability {
    supportMediaControl: Optional<bool>;
    supportTelephonyControl: Optional<bool>;
}

struct PartnerDeviceAddress {
    bluetoothAddress: Optional<common.BluetoothAddress>;
}

enum PartnerAgentExtensionAbilityDestroyReason: i32 {
    UNKNOWN_REASON = 0,
    USER_CLOSED_ABILITY = 1,
    DEVICE_UNPAIRED = 2,
    DEVICE_LOST = 3,
    BLUETOOTH_DISABLED = 4
}
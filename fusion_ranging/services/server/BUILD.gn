import("//build/ohos.gni")
import("//build/ohos_var.gni")

FUSION_RANGING = "//foundation/communication/fusion_connectivity/fusion_ranging"

config("fusion_ranging_config") {
  include_dirs = [
    "${target_gen_dir}",
    "$FUSION_RANGING/interfaces/inner_api",
    "include",
    "$FUSION_RANGING/../partner_agent/frameworks/inner/include",
    "$FUSION_RANGING/../partner_agent/interfaces/inner_api",
    "$FUSION_RANGING/../partner_agent/services/common/include",
    "../common/include",
  ]

  cflags_cc = [
    "-Wno-return-type-c-linkage",
  ]
}

ohos_shared_library("fusion_ranging_server") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    boundary_sanitize = true
    cfi_cross_dso = true
    integer_overflow = true
    ubsan = true
    debug = false
  }

  cflags_cc = [
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-unwind-tables",
    "-fno-asynchronous-unwind-tables",
    "-Os",
    "-fvisibility=hidden",
  ]

  configs = [
    ":fusion_ranging_config"
  ]

  defines = [
    "LOG_DOMAIN = 0xD000100",
  ]

  sources = [
    "src/fusion_ranging_server.cpp",
    "src/process_death_manager.cpp",
    "$FUSION_RANGING/../partner_agent/services/common/src/permission_manager.cpp",
  ]

  include_dirs = [
    "include",
    "${target_gen_dir}",
    "$FUSION_RANGING/interfaces/inner_api",
    "$FUSION_RANGING/idl/include",
    "$FUSION_RANGING/../partner_agent/services/common/include",
  ]

  deps = [
    "$FUSION_RANGING/idl:libfusion_ranging_proxy",
    "$FUSION_RANGING/idl:libfusion_ranging_stub",
    "$FUSION_RANGING/services/etc/init:etc",
    "$FUSION_RANGING/services/service:fusion_ranging_service",
    "$FUSION_RANGING/services/ranging_adapter:fusion_ranging_adapter",
    "$FUSION_RANGING/services/common:fusion_ranging_common",
  ]

  external_deps = [
    "hilog:libhilog",
    "ipc:ipc_single",
    "c_utils:utils",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "ability_runtime:app_manager",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "access_token:libprivacy_sdk",
    "bundle_framework:appexecfwk_base",
  ]

  part_name = "fusion_connectivity"
  subsystem_name = "communication"
}
import("//build/ohos.gni")

FUSION_RANGING = "//foundation/communication/fusion_connectivity/fusion_ranging"

ohos_shared_library("ranging") {
  branch_protector_ret = "pac_ret"  # Enable PAC CFI

  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    boundary_sanitize = true  # Enable boundary san detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    integer_overflow = true  # Enable integer overflow detection
    ubsan = true  # Enable some Ubsan options
    cfi_vcall_icall_only = true  # CFI optimization, limiting the detection scope
    debug = false
  }

  sources = [
    "src/napi_fusion_ranging.cpp",
    "src/napi_fusion_ranging_constant.cpp",
    "src/napi_fusion_ranging_callback.cpp",
    "src/napi_fusion_ranging_utils.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_fusion_connectivity_error.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_ha_event_utils.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_parser_utils.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_async_callback.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_async_work.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_native_object.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_timer.cpp",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/src/napi_event_subscribe_module.cpp",
  ]

  include_dirs = [
    "include",
    "${target_gen_dir}",
    "$FUSION_RANGING/idl/include",
    "$FUSION_RANGING/interfaces/inner_api",
    "$FUSION_RANGING/../partner_agent/frameworks/napi/include",
    "$FUSION_RANGING/../partner_agent/frameworks/inner/include",
    "$FUSION_RANGING/../partner_agent/interfaces/inner_api",
  ]

  defines = [
    "LOG_DOMAIN = 0xD000100",
  ]

  deps = [
    "$FUSION_RANGING/idl:libfusion_ranging_stub",
    "$FUSION_RANGING/frameworks/inner:fusion_ranging_manager_framework",
    "$FUSION_RANGING/services/common:fusion_ranging_common",
  ]

  external_deps = [
    "hilog:libhilog",
    "c_utils:utils",
    "libuv:uv",
    "napi:ace_napi",
    "hiappevent:hiappevent_innerapi",
  ]

  configs = [
    ":fusion_ranging_napi_config",
  ]

  ldflags = [
    "-flto",
    "-Wl,--as-needed",
    "-Wl,--gc-sections",
  ]

  relative_install_dir = "module/fusionconnectivity"
  part_name = "fusion_connectivity"
  subsystem_name = "communication"
}

config("fusion_ranging_napi_config") {
  cflags_cc = [
    "-Wno-unused-parameter",
    "-ffunction-sections",
    "-fdata-sections",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Oz",
    "-fno-rtti",
    "-fno-exceptions",
    "-fno-merge-all-constants",
    "-flto",
  ]
}